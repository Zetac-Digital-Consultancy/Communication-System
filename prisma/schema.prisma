generator client {
  provider = "prisma-client-js"
}

model LoginAttempt {
  key String @id
  count Int
  expiresAt DateTime

  @@index([expiresAt])
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  avatar    String?
  role      UserRole @default(USER)
  userType  UserType @default(KUNDE)
  isActive  Boolean  @default(true)
  sessionVersion Int @default(0)
  createdAt DateTime @default(now())

  sentMessages      Message[]          @relation("SentMessages")
  notifications     Notification[]
  conversationsAsA  Conversation[]     @relation("ParticipantA")
  conversationsAsB  Conversation[]     @relation("ParticipantB")
  contacts          Contact[]          @relation("UserContacts")
  contactOf         Contact[]          @relation("ContactOf")
  availabilitySlots AvailabilitySlot[]
  blocks UserBlock[] @relation("Blocker")
  blockedBy UserBlock[] @relation("Blocked")
  reports AbuseReport[] @relation("Reporter")
  reportsAgainst AbuseReport[] @relation("Reported")
}

model Conversation {
  id             String   @id @default(cuid())
  participantAId String
  participantBId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  participantA User      @relation("ParticipantA", fields: [participantAId], references: [id])
  participantB User      @relation("ParticipantB", fields: [participantBId], references: [id])
  messages     Message[]

  @@unique([participantAId, participantBId])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  senderId       String
  content        String?
  type           MessageType @default(TEXT)
  fileUrl        String?
  fileName       String?
  createdAt      DateTime    @default(now())
  readAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@index([fileUrl])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  messageId String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
}

enum UserRole {
  USER
  ADMIN
}

enum UserType {
  KUNDE
  PARTNER
}

enum NotificationType {
  MESSAGE
  IMAGE
  VIDEO
}

model AvailabilitySlot {
  id        String           @id @default(cuid())
  userId    String
  start     DateTime
  end       DateTime
  type      AvailabilityType @default(FREE)
  note      String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, start])
}

enum AvailabilityType {
  FREE
  BUSY
}

model Contact {
  id            String   @id @default(cuid())
  userId        String
  contactUserId String
  createdAt     DateTime @default(now())

  user        User @relation("UserContacts", fields: [userId], references: [id], onDelete: Cascade)
  contactUser User @relation("ContactOf", fields: [contactUserId], references: [id], onDelete: Cascade)

  @@unique([userId, contactUserId])
}

model UserBlock {
  blockerId String
  blockedId String
  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  @@id([blockerId, blockedId])
}

model AbuseReport {
  id String @id @default(cuid())
  reporterId String
  reportedId String
  reason String
  resolved Boolean @default(false)
  createdAt DateTime @default(now())
  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("Reported", fields: [reportedId], references: [id], onDelete: Cascade)
  @@index([resolved, createdAt])
}
