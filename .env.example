# Required: session encryption key, at least 32 characters.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

# Set to "true" when serving over HTTPS (or set APP_URL to an https:// URL).
COOKIE_SECURE=false
# APP_URL=https://example.com

# Set to "true" to create demo users/messages on container startup.
SEED_DEMO_DATA=false

# Only needed for local (non-Docker) development; the Docker image sets its own.
# DATABASE_URL=file:./prisma/dev.db
