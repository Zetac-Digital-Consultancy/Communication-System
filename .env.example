# Required: session encryption key, at least 32 characters.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

# Set to "true" when serving over HTTPS (or set APP_URL to an https:// URL).
COOKIE_SECURE=true
APP_URL=https://communication-system.zetac.de

# Legacy safeguard: demo seeding is not supported. Keep this false.
SEED_DEMO_DATA=false

# Only needed for local (non-Docker) development; the Docker image sets its own.
DATABASE_URL=file:./dev.db

# Private storage; must never be placed inside public/.
# UPLOAD_DIR=/app/uploads
# Set to the published HTTPS privacy policy before App Store submission.
# PRIVACY_POLICY_URL=https://...

# One-time first administrator setup: supply these only when running npm run db:seed.
# No account or password defaults exist; never commit real values.
# INITIAL_ADMIN_NAME=
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_PASSWORD=
