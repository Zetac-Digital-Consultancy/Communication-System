# Required: session encryption key, at least 32 characters.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

# Set to "true" when serving over HTTPS (or set APP_URL to an https:// URL).
COOKIE_SECURE=true
APP_URL=https://communication-system.zetac.de

# Set to "true" to create demo users/messages on container startup.
SEED_DEMO_DATA=false

# Only needed for local (non-Docker) development; the Docker image sets its own.
DATABASE_URL=file:./dev.db

# Private storage; must never be placed inside public/.
# UPLOAD_DIR=/app/uploads
# Set to the published HTTPS privacy policy before App Store submission.
# PRIVACY_POLICY_URL=https://...
